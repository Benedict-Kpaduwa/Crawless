{
  "name": "crawless",
  "version": "0.1.0",
  "description": "Crawless — a desktop workflow editor for building and running web crawlers.",
  "author": "Benedict Kpaduwa",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benedict-Kpaduwa/Crawless.git"
  },
  "packageManager": "pnpm@10.23.0",
  "build": {
    "appId": "crawless.menu",
    "extraMetadata": {
      "main": "build/electron.js"
    },
    "files": [
      "build/**/*",
      "package.json"
    ]
  },
  "homepage": "./",
  "main": "public/electron.js",
  "private": true,
  "dependencies": {
    "@codemirror/commands": "^6.1.2",
    "@codemirror/lang-markdown": "^6.0.5",
    "@codemirror/lang-javascript": "^6.2.1",
    "@codemirror/language": "^6.3.1",
    "@codemirror/language-data": "^6.1.0",
    "@codemirror/state": "^6.1.4",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.5.1",
    "@crawless/ui": "^1.0.228",
    "@lezer/highlight": "^1.1.2",
    "@reduxjs/toolkit": "^1.8.6",
    "@uiw/codemirror-theme-vscode": "^4.15.1",
    "@uiw/codemirror-themes": "^4.15.1",
    "@uiw/codemirror-themes-all": "^4.15.1",
    "@uiw/react-codemirror": "^4.15.1",
    "axios": "^1.2.0",
    "codemirror": "^6.0.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.2",
    "electron-is-dev": "^2.0.0",
    "lodash": "^4.17.21",
    "marked": "^14.1.4",
    "rc-tooltip": "^5.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.6.0",
    "react-redux": "^8.0.4",
    "react-resize-detector": "^7.1.2",
    "react-router-dom": "^6.4.2",
    "react-split": "^2.0.14",
    "react-toastify": "^9.1.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "concurrently \"cross-env BROWSER=none pnpm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "pnpm run build && node scripts/obfuscate-main.js && electron-builder -wml"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.12",
    "concurrently": "^7.4.0",
    "electron": "^20.1.3",
    "electron-builder": "^23.5.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.18",
    "tailwind-scrollbar": "^2.0.1",
    "tailwindcss": "^3.1.8",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wait-on": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "esbuild",
      "fsevents",
      "core-js",
      "core-js-pure"
    ]
  }
}
